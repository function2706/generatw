{
  "id": "main",
  "ignition": {
    "mode": "any",
    "patterns": [
      "today:"
    ]
  },
  "fields": {
    "((?<=/[0-9]+,\\s).*(?=\\s\\(vibe))": {
      "capturegrp": 0,
      "priority": 1,
      "type": "maps",
      "table": {
        "Name1": "name1,feature1",
        "Name2": "name2,feature2"
      }
    },
    "vibe:\\s([^\\)]*)": {
      "capturegrp": 1,
      "priority": 2,
      "type": "maps",
      "table": {
        "Vibe1": "vibe1",
        "Vibe2": "vibe2"
      },
      "default": "vibe3"
    },
    "(1|2)[0-9]{3}/([0-9]{2})": {
      "capturegrp": 2,
      "priority": 3,
      "type": "ranges",
      "table": {
        "spring": [
          "03",
          "04",
          "05",
          "06"
        ],
        "summer": [
          "07",
          "08"
        ],
        "autumn": [
          "09",
          "10"
        ],
        "winter": [
          "11",
          "12",
          "01",
          "02"
        ]
      }
    },
    "(sunny|rainy)": {
      "capturegrp": 0,
      "priority": 4,
      "type": "maps",
      "table": {
        "sunny": "sunny",
        "rainy": "rainy"
      },
      "default": "cloudy"
    },
    "(hoge|fuga)": {
      "capturegrp": 0,
      "priority": 5,
      "type": "maps",
      "table": {
        "hoge": "smile",
        "fuga": "angry"
      },
      "default": "crying"
    }
  }
}