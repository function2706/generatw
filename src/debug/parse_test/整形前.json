{
    "main": {
        "ignition": {
            "any": [
                "today:"
            ]
        },
        "character": {
            "name": {
                "pattern": "[0-9]{2},\\s(\\w*)",
                "priority": 4,
                "capturegrp": 1,
                "lifetime": "stable",
                "maps": {
                    "Name1": "name1,feature1",
                    "Name2": {
                        "positive": "name2,feature2",
                        "negative": "NAME2"
                    }
                }
            },
            "vibe": {
                "pattern": "vibe:\\s([^\\)]*)",
                "priority": 2,
                "capturegrp": 1,
                "lifetime": "stable",
                "maps": {
                    "Vibe1": "vibe1",
                    "Vibe2": "vibe2"
                },
                "default": "vibe3"
            }
        },
        "meta": {
            "date": {
                "pattern": "(1|2)[0-9]{3}/([0-9]{2})",
                "priority": 1,
                "capturegrp": 2,
                "lifetime": "stable",
                "ranges": {
                    "spring": [
                        "03",
                        "04",
                        "05",
                        "06"
                    ],
                    "summer": [
                        "07",
                        "08"
                    ],
                    "autumn": [
                        "09",
                        "10"
                    ],
                    "winter": {
                        "conditions": [
                            "11",
                            "12",
                            "01",
                            "02"
                        ],
                        "negative": "HOT"
                    }
                }
            },
            "weather": {
                "pattern": "(sunny|rainy)",
                "priority": 4,
                "maps": {
                    "sunny": "sunny",
                    "rainy": "rainy"
                },
                "default": "cloudy"
            }
        },
        "test": {
            "foobar": {
                "pattern": "(foo|bar|Bar|Baz|baz)",
                "priority": 1,
                "maps": {
                    "foo": {
                        "positive": "foo",
                        "negative": "FOO,(nope:1.1)"
                    },
                    "bar": {
                        "positive": "(bar:1.3)",
                        "negative": "BAR,(nope:1.2),nyome"
                    },
                    "Bar": {
                        "positive": "(bar:1.1)",
                        "negative": "BAR,(nope:1.2)"
                    },
                    "Baz": {
                        "negative": "BAZ,(nope:1.4)"
                    },
                    "baz": {
                        "positive": "baz"
                    }
                }
            },
            "hogefuga": {
                "pattern": "([hH]oge|[fF]uga)",
                "ranges": {
                    "(hoge:1.3)": {
                        "conditions": [
                            "hoge"
                        ],
                        "negative": "HOGE,nope"
                    },
                    "(hoge:1.2)": {
                        "conditions": [
                            "Hoge"
                        ]
                    },
                    "fuga": {
                        "conditions": [
                            "fuga",
                            "Fuga"
                        ],
                        "negative": "FUGA,(nope:1.3)"
                    }
                }
            }
        },
        "POSITIVE": "common positive",
        "NEGATIVE": "common negative"
    },
    "sub": {
        "ignition": {
            "all": [
                "sub:",
                "WOW"
            ]
        },
        "mood": {
            "pattern": "mood:\\s([^\\)]*)\\s",
            "priority": 1,
            "capturegrp": 1,
            "maps": {
                "Mood1": "mood1",
                "Mood2": {
                    "positive": "mood2",
                    "negative": "MOOD2"
                }
            },
            "default": "mood3"
        },
        "equipment": {
            "pattern": "equip:\\s([^\\)]*)\\s",
            "priority": 2,
            "capturegrp": 1,
            "ranges": {
                "shirt": [
                    "Blouse, Shirt"
                ],
                "(pants:1.2)": [
                    "Pants"
                ],
                "pants": {
                    "conditions": [
                        "Shorts",
                        "Slacks"
                    ],
                    "negative": "skirt"
                },
                "caps": [
                    "Caps"
                ]
            }
        },
        "POSITIVE": "sub common positive",
        "NEGATIVE": "sub common negative"
    }
}